# Backend Dockerfile - Development Stage
FROM node:20-alpine AS dev

WORKDIR /app/backend

# Install dependencies for Prisma and health checks
RUN apk add --no-cache openssl wget curl

# Copy package files
COPY backend/package*.json ./

# Copy Prisma schema (needed for generate)
COPY backend/prisma ./prisma

# Install dependencies (exact versions)
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

# Copy source code
COPY backend/src ./src

# Expose port
EXPOSE 8080

# Startup script: run migrations then start server with hot reload
CMD sh -c "npx prisma migrate deploy && npx tsx watch src/index.ts"

